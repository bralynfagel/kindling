	quest.2380FFD3F4AA2DEC.quest_desc: [
		"Everyone starts here. Your rank shows before your name."
		""
		"Copper plays at the &eHaven&r world tier: tougher mobs, better loot."
		""
		"Earn 3 rank tokens: clear dungeons at your rank or one above."
		"Every dungeon gate and rift shows its rank by colour."
	]
