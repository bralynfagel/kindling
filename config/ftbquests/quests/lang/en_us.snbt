	quest.19662AD01F85C93D.quest_desc: [
		"Diamond ore needs &bMining 16&r to break. Every rung below it is reachable from coal, copper and iron."
	]
	quest.19662AD01F85C93D.quest_subtitle: "Mine a diamond (needs Mining 16)"
	quest.19662AD01F85C93D.title: "&bDiamonds"
	quest.1C1EBD5257E80C06.quest_subtitle: "Throw an eye of ender"
	quest.1C1EBD5257E80C06.title: "Follow the Eye"
	quest.1DCAB48505E13AC8.quest_desc: [
		"Weaken a wild Pokémon, then throw a ball."
		"Your party is on &lM&r; send out your lead with &lR&r."
	]
	quest.1DCAB48505E13AC8.quest_subtitle: "Catch a Pokémon"
	quest.1DCAB48505E13AC8.title: "First Catch"
	quest.290AB97E63BB1C6B.quest_subtitle: "Craft a vending machine"
	quest.290AB97E63BB1C6B.title: "Vending"
	quest.29C0B076B00CE8E2.quest_subtitle: "Craft a cutting board"
	quest.29C0B076B00CE8E2.title: "Chop Chop"
	quest.2C88373B0554F325.quest_desc: [
		"Rare. Don't grind for it — it'll happen."
	]
	quest.2C88373B0554F325.quest_subtitle: "Catch a shiny"
	quest.2C88373B0554F325.title: "&dSomething Sparkles"
	quest.30784F035FC8A107.quest_subtitle: "Defeat 10 skeletons"
	quest.30784F035FC8A107.title: "Bone Collector"
	quest.33E4C838918981E7.quest_desc: [
		"A family server. Build, catch, trade, explore — at your own pace."
		""
		"&eQuests&r (this book) guide you. Tick this one to claim a starter kit."
		"&eSkill trees&r: press &lK&r. Three trees level from what you already do."
		"&eYour map&r: &lM&r is your Pokémon party; the minimap is top-left."
		""
		"Stuck, lost, or something broke? Say so in chat. Nothing here is permanent."
	]
	quest.33E4C838918981E7.quest_subtitle: "Read me first"
	quest.33E4C838918981E7.title: "&6Welcome to Kindling"
	quest.3B9C741C90878B7F.quest_desc: [
		"Apricorns grow on trees in the wild. Pick them, cook them, craft balls."
	]
	quest.3B9C741C90878B7F.quest_subtitle: "Craft Poké Balls"
	quest.3B9C741C90878B7F.title: "Ball Crafter"
	quest.3F761C90B071539B.quest_desc: [
		"Three trees, each levelled by doing its thing:"
		""
		"&cAdventurer&r — defeating monsters and wild Pokémon"
		"&7Prospector&r — mining ore and chopping logs"
		"&aHomestead&r — crafting, cooking, eating, fishing"
		""
		"You start with one point in each. Tick this when you've spent one."
	]
	quest.3F761C90B071539B.quest_subtitle: "Press K and spend a point"
	quest.3F761C90B071539B.title: "Your Skill Trees"
	quest.423CB41EC9CAB8A4.quest_subtitle: "Pick a berry"
	quest.423CB41EC9CAB8A4.title: "Berry Picking"
	quest.433DE22EADA63DF0.quest_subtitle: "Smelt iron"
	quest.433DE22EADA63DF0.title: "Iron Age"
	quest.44C75AA2C097C55B.quest_desc: [
		"Backpacks can be upgraded later. Right-click to open, or use your backpack key."
	]
	quest.44C75AA2C097C55B.quest_subtitle: "Craft a backpack"
	quest.44C75AA2C097C55B.title: "Carry More"
	quest.4F039727611BC086.quest_subtitle: "Craft an oak table"
	quest.4F039727611BC086.title: "Make It Home"
	quest.50B94D7784F72104.quest_subtitle: "Evolve a Pokémon"
	quest.50B94D7784F72104.title: "Growing Up"
	quest.5129BE1A08DF5129.quest_subtitle: "Wear some armor"
	quest.5129BE1A08DF5129.title: "Suit Up"
	quest.5B455646159A9A64.quest_desc: [
		"Activate every waystone you find. Once activated, you can teleport between them."
	]
	quest.5B455646159A9A64.quest_subtitle: "Spot a waystone — villages usually have one"
	quest.5B455646159A9A64.title: "Find a Waystone"
	quest.5DE52B536C535972.quest_subtitle: "Craft a cooking pot"
	quest.5DE52B536C535972.title: "Proper Kitchen"
	quest.6914F3F618BD7F46.quest_desc: [
		"Place it, stock it, set a price. Other players buy while you're away."
		"&eShoppers&r — travelling villagers — will visit shops and buy too."
	]
	quest.6914F3F618BD7F46.quest_subtitle: "Craft a display case"
	quest.6914F3F618BD7F46.title: "Open for Business"
	quest.6B128737481D1ED8.quest_desc: [
		"Crops grow in their seasons. The calendar tells you which it is."
	]
	quest.6B128737481D1ED8.quest_subtitle: "Craft a calendar"
	quest.6B128737481D1ED8.title: "Mind the Seasons"
	quest.7AE3CCA2F1C8F159.quest_desc: [
		"Kindling runs on one currency: Lightman's coins."
		""
		"10 copper = 1 iron, 10 iron = 1 gold, and so on up."
		"Quests pay in coins. So do other players."
	]
	quest.7AE3CCA2F1C8F159.quest_subtitle: "Hold 10 copper coins"
	quest.7AE3CCA2F1C8F159.title: "Pocket Change"
	quest.7BA050781C5D41CC.quest_subtitle: "Enter the Nether"
	quest.7BA050781C5D41CC.title: "Into the Fire"
	chapter.6B1D3A57C0E2F481.title: "Kindling Basics"
	quest.6B1D3A57C0E2F482.title: "Five Paths"
	quest.6B1D3A57C0E2F482.quest_subtitle: "Open your skill trees with K"
	quest.6B1D3A57C0E2F482.quest_desc: [
		"Everything you do earns experience in one of five trees: Adventurer (fighting), Prospector (mining),"
		"Homestead (crafting, cooking, fishing), Trainer (Pokemon) and Arcanist (spells)."
		"Each level gives a point to spend in that tree. One player can finish every tree."
	]
	quest.6B1D3A57C0E2F483.title: "Sort It Out"
	quest.6B1D3A57C0E2F483.quest_subtitle: "Middle-click in any inventory to sort it"
	quest.6B1D3A57C0E2F483.quest_desc: [
		"Middle-click sorts the inventory under your cursor: weapons, tools, armor, Poke Balls, coins, gems, food, metals..."
		"The order lives in config/invtweaks-client.toml and is yours to change."
	]
	quest.6B1D3A57C0E2F484.title: "Stash It"
	quest.6B1D3A57C0E2F484.quest_subtitle: "Sneak + right-click a chest with an empty hand"
	quest.6B1D3A57C0E2F484.quest_desc: [
		"Hot deposit sends what you carry into nearby chests (8 blocks) that already hold the same thing."
		"Gear goes by type: a chest with one helmet takes every helmet."
		"Your hotbar, worn armor and backpacks never move. Keep an item with /stash keep."
	]
	quest.6B1D3A57C0E2F485.title: "Ways Home"
	quest.6B1D3A57C0E2F485.quest_subtitle: "Craft a waystone"
	quest.6B1D3A57C0E2F485.quest_desc: [
		"Activate a waystone once and you can travel back to it for free. Put one at home first."
	]
	quest.6B1D3A57C0E2F486.title: "Soft Landings"
	quest.6B1D3A57C0E2F486.quest_subtitle: "Learn what happens when you die"
	quest.6B1D3A57C0E2F486.quest_desc: [
		"When you die, your things wait in a gravestone where you fell."
		"A Recovery Compass stays with you through death: sneak and use it to return to your last grave."
	]
	quest.6B1D3A57C0E2F487.title: "Scrap Heap"
	quest.6B1D3A57C0E2F487.quest_subtitle: "Craft a Salvaging Table"
	quest.6B1D3A57C0E2F487.quest_desc: [
		"Gear you do not want becomes materials. Plain gear gives back what it was made of;"
		"gear with a rarity gives that rarity's material for reforging. Remove socketed gems first (Sigil of Withdrawal)."
	]
	quest.6B1D3A57C0E2F488.title: "Second Chances"
	quest.6B1D3A57C0E2F488.quest_subtitle: "Craft a Simple Reforging Table"
	quest.6B1D3A57C0E2F488.quest_desc: [
		"Reforging rerolls an item's bonuses (affixes) at a rarity you choose, using that rarity's material,"
		"Gem Dust and levels. It works on plain gear too: any weapon or armor can become Common or better."
	]
	quest.6B1D3A57C0E2F489.title: "Facets"
	quest.6B1D3A57C0E2F489.quest_subtitle: "Craft a Gem Cutting Table"
	quest.6B1D3A57C0E2F489.quest_desc: [
		"Gems go into sockets on gear. Combine gems here to raise their quality."
		"Add sockets with a Sigil of Socketing at a smithing table."
	]
	quest.6B1D3A57C0E2F48A.title: "The Climb"
	quest.6B1D3A57C0E2F48A.quest_subtitle: "Read about World Tiers"
	quest.6B1D3A57C0E2F48A.quest_desc: [
		"Apotheosis World Tiers (Haven, Frontier, Ascent, Summit, Pinnacle) set how dangerous the world is"
		"and how good the loot gets. You unlock tiers by playing and choose one on the World Tier screen."
		"Better gear, including Epic Knights and Iron's robes, shows up at higher tiers."
	]
	quest.6B1D3A57C0E2F48B.title: "Coin of the Realm"
	quest.6B1D3A57C0E2F48B.quest_subtitle: "Coins are the only money"
	quest.6B1D3A57C0E2F48B.quest_desc: [
		"Villagers and wandering traders pay and charge in Lightman's coins, not emeralds."
		"Coins also buy from player shops; see the Hearth & Market chapter."
	]
}
