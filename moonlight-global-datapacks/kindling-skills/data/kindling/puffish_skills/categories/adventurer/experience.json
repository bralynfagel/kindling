{
  "level_limit": 30,
  "experience_per_level": {
    "type": "expression",
    "data": {
      "expression": "level * 15 + 25"
    }
  },
  "sources": [
    {
      "type": "puffish_skills:kill_entity",
      "data": {
        "variables": {
          "dropped_xp": {
            "operations": [
              {
                "type": "get_dropped_experience"
              }
            ]
          },
          "max_health": {
            "operations": [
              {
                "type": "get_killed_living_entity"
              },
              {
                "type": "get_max_health"
              }
            ]
          },
          "is_pokemon": {
            "operations": [
              {
                "type": "get_killed_living_entity"
              },
              {
                "type": "get_type"
              },
              {
                "type": "puffish_skills:test",
                "data": {
                  "entity_type": "cobblemon:pokemon"
                }
              }
            ]
          }
        },
        "experience": [
          {
            "condition": "is_pokemon",
            "expression": "dropped_xp + max_health / 8 + 4"
          },
          {
            "expression": "dropped_xp + max_health / 10"
          }
        ],
        "anti_farming": {
          "limit_per_chunk": 20,
          "reset_after_seconds": 300
        }
      }
    }
  ]
